# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# OpenWeatherMap API
# Sign up at https://openweathermap.org/api to get a free API key.
# If omitted or invalid, the app automatically switches to realistic fallback mock data for testing.
OPENWEATHER_API_KEY=

# In-Memory Cache TTL in seconds (e.g. 600 = 10 minutes)
CACHE_TTL_SECONDS=600
